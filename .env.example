# ── Knowledge base and retrieval ──────────────────────────────────────────
QA_DATA_DIR=data/knowledge
QA_INDEX_PATH=data/index.json
QA_CONFIDENCE_THRESHOLD=0.08
QA_TOP_K=5
QA_ENABLE_RERANKER=false
QA_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── LLM provider ──────────────────────────────────────────────────────────
# Supported providers: auto, openai, gemini. Auto uses OpenAI when configured, then Gemini.
QA_LLM_PROVIDER=auto

# OpenAI-compatible Chat Completions provider (server-side only)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=minimal
OPENAI_MAX_COMPLETION_TOKENS=3000
# Use "reasoning" for compatible gateways that expose this non-standard parameter.
# OPENAI_REASONING_PARAM=reasoning

# Or use Google Gemini instead
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Conversation history ───────────────────────────────────────────────────
# Number of conversation turns (user+assistant pairs) to keep per session
QA_MAX_HISTORY_TURNS=10
